{
  "name": "usagi-launcher",
  "version": "0.5.0",
  "private": true,
  "description": "Usagi SMP launcher for Windows",
  "author": "Usagi SMP",
  "license": "UNLICENSED",
  "type": "module",
  "overrides": {
    "@xmcl/unzip": {
      "@xmcl/yauzl": "2.10.0"
    }
  },
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "tsc --noEmit && vite build && node tools/build-main.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:gui": "node tools/gui-test.mjs",
    "test:startup": "node tools/startup-test.mjs",
    "test:presence-gui": "node tools/presence-gui-test.mjs",
    "test:social-gui": "node tools/social-gui-test.mjs",
    "test:forge-wire": "node tools/social-forge-wire-test.mjs",
    "test:presence-forge-wire": "node tools/presence-forge-wire-test.mjs",
    "build:social": "node tools/build-social.mjs",
    "package:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "smp.celestia.launcher",
    "productName": "Usagi",
    "artifactName": "Usagi-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "config/**/*",
      "package.json",
      "ASSET_CREDITS.md",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.7.1",
    "@types/ws": "8.18.2",
    "@xmcl/yauzl": "2.10.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "dependencies": {
    "@azure/msal-node": "7.1.2",
    "@fontsource/inter": "5.3.0",
    "@xmcl/core": "2.16.2",
    "@xmcl/installer": "6.3.6",
    "@xmcl/user": "4.4.2",
    "electron-updater": "6.8.11",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.7.3",
    "undici": "7.30.1",
    "zod": "4.6.7"
  }
}
