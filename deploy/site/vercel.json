{
  "version": 2,
  "outputDirectory": "public",
  "headers": [
    {"source":"/launcher/channels/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/modpacks/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/news/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=60"}]},
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"}]}
  ]
}
